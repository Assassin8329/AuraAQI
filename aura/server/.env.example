# Copy to .env

# AI provider selection
AI_PROVIDER=openai

# Provider-specific API keys (only needed for the selected provider)
AI_API_KEY=

# Provider-specific endpoint (usually not needed — defaults are below)
AI_ENDPOINT=

# Provider-specific model (only needed if not using the default)
AI_MODEL=

# World Air Quality Index ground-station token (https://aqicn.org/data-platform/token/)
# Leave blank to use Open-Meteo's free model-based AQI as the primary source.
WAQI_TOKEN=your_waqi_token_here

# Server port
SERVER_PORT=3001

# --- Provider defaults ---
# OpenAI:     ai.openai.com/v1  | model: gpt-5.6-luna
# Anthropic:  api.anthropic.com/v1/  | model: claude-haiku-4-5-20251101
# Google:     generativelanguage.googleapis.com/v1beta/openai/  | model: gemini-3.8-flash
# xAI:        api.x.ai/v1  | model: grok-4.7
# DeepSeek:   api.deepseek.com  | model: deepseek-v4-pro
# Mistral:    api.mistral.ai/v1  | model: mistral-large-latest
# OpenRouter: openrouter.ai/api/v1  | model: openrouter/free
# Together:   api.together.xyz/v1  | model: meta-llama/Llama-3.3-70B-Instruct-Turbo
# Perplexity: api.perplexity.ai  | model: sonar-pro
# Groq:       api.groq.com/openai/v1  | model: openai/gpt-oss-120b
