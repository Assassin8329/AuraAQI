# Copy to .env.local (for Vite dev server only).

# World Air Quality Index ground-station data (https://aqicn.org/data-platform/token/)
# Leave blank to use Open-Meteo's free model-based AQI.
VITE_WAQI_TOKEN=

# AI Provider (openai | anthropic | google | xai | deepseek | mistral | openrouter | together | perplexity | groq | pollinations | ollama | lmstudio)
VITE_AI_PROVIDER=openai

# AI API key for the above provider (optional — app falls back to Pollinations for free live AI)
VITE_AI_API_KEY=

# Model to use (optional — uses the provider's default if blank)
VITE_AI_MODEL=

# Demo mode: set to "1" to use pre-built advice cards without any API calls
VITE_DEMO_MODE=
